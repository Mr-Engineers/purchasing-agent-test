# proxy  = LLM and apps through proxy-server (PROXY_URL required; URLs below default to it)
# direct = Bedrock and the apps without the proxy, for tests (WAREHOUSE_URL, MARKETPLACE_URL required)
AGENT_MODE=direct

# LLM: Chat Completions (OpenAI-compatible). In direct mode auth comes from the AWS credential
# chain (ECS task role on Fargate, AWS_PROFILE locally) unless LLM_API_KEY is set.
# In proxy mode defaults to <PROXY_URL>/v1 with AGENT_KEY.
LLM_BASE_URL=https://bedrock-runtime.eu-north-1.amazonaws.com/openai/v1
LLM_MODEL=qwen.qwen3-32b-v1:0
AWS_REGION=eu-north-1
LLM_THINK=false

# Apps. In proxy mode default to <PROXY_URL>/apps/warehouse and <PROXY_URL>/apps/marketplace.
WAREHOUSE_URL=http://localhost:8000/api/v1
MARKETPLACE_URL=http://localhost:8002

# direct mode: Authorization: Bearer for each app.
# WAREHOUSE_TOKEN = the backend's GATEWAY_TOKEN (needed for POST /purchase-orders),
# MARKETPLACE_TOKEN = the marketplace API token.
WAREHOUSE_TOKEN=
MARKETPLACE_TOKEN=
# AGENT_ID=purchasing-agent

# proxy mode
# PROXY_URL=http://proxy-server:8080
# AGENT_KEY=
# true once the proxy has POST /v1/sessions (X-Session-Id, approvals)
# PROXY_SESSIONS=false

POLL_INTERVAL_S=30
MAX_PARALLEL_SESSIONS=4
MAX_LLM_STEPS=10
# true = one scan of the warehouse, wait for all sessions, exit
RUN_ONCE=false
